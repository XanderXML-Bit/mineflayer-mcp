{
  "name": "minecraft-mcp-mineflayer",
  "version": "1.0.0",
  "description": "An MCP for AI Agents to use to operate and play in minecraft",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --enable-source-maps --watch dist/index.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tests/types/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XanderXML-Bit/mineflayer-mcp.git"
  },
  "keywords": [],
  "author": "Xander M. Lopez",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/XanderXML-Bit/mineflayer-mcp/issues"
  },
  "homepage": "https://github.com/XanderXML-Bit/mineflayer-mcp#readme",
  "bin": {
    "minecraft-mcp-mineflayer": "bin/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "minecraft-data": "^3.97.0",
    "mineflayer": "^4.32.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.1.10",
    "yaml": "^2.6.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.52.0",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
